generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  passwordHash String
  name      String?

  reviews   Review[]
  followers Follow[] @relation("follows")
  following Follow[] @relation("followedBy")
  likes     Like[]

  recommendationCache   RecommendationCache[]
  recommendationFeedback RecommendationFeedback[]
}

model Film {
  id         Int      @id @default(autoincrement())
  tmdbId     Int      @unique
  title      String
  posterPath String?
  year       String?
  genres     Json?    // хранит массив строк (JSON)

  reviews    Review[]
  recommendationCache   RecommendationCache[]
  recommendationFeedback RecommendationFeedback[]
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  filmId     Int
  status     String   // 'watched', 'want', 'favorite'
  rating     Int?
  reviewText String?
  createdAt  DateTime @default(now())
  isPublic   Boolean  @default(false)
  isFavorite Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film       Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  likes      Like[]

  @@unique([userId, filmId])
}

model Follow {
  id          Int   @id @default(autoincrement())
  followerId  Int
  followingId Int

  follower   User @relation("follows", fields: [followerId], references: [id], onDelete: Cascade)
  following  User @relation("followedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Like {
  userId   Int
  reviewId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model RecommendationCache {
  id        Int      @id @default(autoincrement())
  userId    Int
  filmId    Int
  score     Float
  reasons   Json     // массив строк
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([userId, expiresAt])
}

model RecommendationFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  filmId    Int
  feedback  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])   // <-- добавьте эту строку
  @@index([userId])
}